@dataclass(frozen=True)
class TelescopeConfig:
    """Default: 130 mm f/5 Newtonian, a light enough payload for a home-built mount."""
    aperture_m: float = 0.130
    focal_length_m: float = 0.650
    obstruction_ratio: float = 0.27       # secondary / primary diameter (0 for a refractor)
    n_spider_vanes: int = 4               # 0 for a refractor; 3 or 4 for most Newtonians
    spider_width_m: float = 0.0010
    spider_angle_deg: float = 0.0         # vanes are fixed to the tube, and so is the camera -> fixed in sensor frame
    optical_throughput: float = 0.80      # two aluminium mirrors (~0.9 each) x coma corrector


@dataclass(frozen=True)
class CameraConfig:
    """Default: 3.76 um CMOS (IMX533 class) at unity gain."""
    pixel_um: float = 3.76
    sensor_shape: tuple = (3008, 3008)    # used only to place the HST field inside a realistic full-frame gradient
    qe: float = 0.80                      # treated as flat across each HST band
    gain_e_per_adu: float = 1.0
    offset_adu: int = 50                  # bias pedestal so negative read noise is preserved before the ADC
    adc_bits: int = 14                    # at unity gain the ADC (16383 e-) saturates before the 50 ke- well
    full_well_e: float = 50_000.0
    read_noise_e: float = 1.5
    dark_e_per_s: float = 0.05            # cooled to ~0 C. An uncooled camera on a 30 C Lahore summer night: 0.5-2 e-/s


