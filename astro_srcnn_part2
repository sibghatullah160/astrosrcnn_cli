# ## 8 · Run
# Every stage saves to `out_dir` on Drive. After a disconnect, reconnect and run all: finished stages are loaded, not
# repeated. In `MODE = "full"` budget roughly 40-70 min for the banks (downloads + CPU simulation), 30-60 min of GPU time for
# 30k iterations, and 15-25 min for the evaluation.

# %%
train_bank = build_bank(CFG.train_targets, CFG.frames_per_train_field, CFG, "train")
val_bank = build_bank(CFG.val_targets, CFG.frames_per_val_field, CFG, "val")
print(f"bank: {len(train_bank)} train / {len(val_bank)} val frames from "
      f"{len({f['field'] for f in train_bank})} training targets, "
      f"{sum(len(f['stars']) for f in train_bank)} catalogued training stars")

# %%
if (OUT / "training_complete.txt").exists() and (OUT / "history.json").exists():
    print("training already finished in an earlier session: loading the best checkpoint")
    model = AstroSRCNN().to(DEVICE)
    model.load_state_dict(torch.load(OUT / "astrosrcnn_best.pt", map_location=DEVICE))
    history = json.load(open(OUT / "history.json"))
else:
    model, history = train(train_bank, val_bank, CFG)

# %%
eval_fields = [f for specs, kind in ((CFG.eval_extended, "extended"), (CFG.eval_stellar, "stellar"))
               for spec in specs for f in load_fields((spec,), kind, CFG, field_rng(CFG, spec[0]), first_only=True)]
print(f"evaluation fields: {[f['label'] for f in eval_fields]}")
evals = [evaluate_field(model, f, CFG, i) for i, f in enumerate(eval_fields)]
results = aggregate(evals, CFG)
json.dump(results, open(OUT / "results.json", "w"), indent=1)
(OUT / "tables.tex").write_text(latex_tables(results))
(OUT / "tables.md").write_text(markdown_tables(results))
export_paper_artifacts(results, history, evals, OUT)   # copy these 4 files next to main.tex in Overleaf
